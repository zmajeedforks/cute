/* flex -Cfe -o cute_lexer.flex.cpp cute_lexer.flex.l */
/* g++ -O0 -Wall -Wextra -Werror -std=c++2b -o cute_lexer cute_lexer.flex.cpp */

 // flex directives

 // turn on warnings
%option warn

 // always generate 8bit lexer
%option 8bit

 // C++ lexer class
%option c++

 // custom C++ lexer classname
%option yyclass="Lexer"

 // custom prefix to turn yyFlexLexer into CuteFlexLexer
%option prefix="Cute"

%option debug

 // disable default rule that echoes unmatched input, gives flex scanner jammed error for any unmatched input
%option nodefault

 // noninteractive lexer has better performance, use with -Cfe
%option never-interactive

%option yylineno

%option noyywrap
 // disable various options for interactive lexer
%option nounput noinput batch

 // flex start conditions ie states
%x OPERATION

%x RULES
%x RULE_START
%x COMMENT

 // top of generated .cpp file
%{

#include <string>
#include <print>

// bison generated header with C++ namespace and token definitions
#include "cute_parser.bison.h"

#include "lexer/cute_lexer.h"

// this is yylex generated by flex but it's name is yylexGen
// it has a different name because it's private and actually called by the public yylex interface that needs to postprocess the token returned by flex rules for lexical feedback
// we choose to make the public yylex interface a simple wrapper that calls yylexGen and sets up lexical feedback before returning the token
// nicer than calling a function on return in every single flex rule
#undef YY_DECL
#define YY_DECL cuteparser::CuteParser::symbol_type cuteparser::Lexer::yylexGen(LexParam& param)


// fix flex error could not convert 0 from int to symbol_type for #define YY_NULL 0
// caused by turning on bison %locations because symbol_type no longer has single int constructor for implicit conversion
#define yyterminate() return symbol_type(YY_NULL, loc)

using namespace std;

using namespace cuteparser;

// needed for custom yyterminate
using symbol_type = CuteParser::symbol_type;

%}

%%

 // code appears inside generated yylex function at start

 // position in input stream
  auto& loc = param.loc;
 // update current position to previous line and column numbers
  loc.step();

 // lexical feedback

 // check for split token to return
  if(lexer_state == lexer_state::sendSplitToken) {
    lexer_state = lexer_state::normal;
    //println("cute.yylex.entry: return split token {}", splitToken.name());
    return splitToken;
  }
  if(lexer_state == lexer_state::opName) {
    numArgLeft = param.get_arg_count(oName);
    lexer_state = lexer_state::argList;
  }
  if(lexer_state == lexer_state::argEnd) {
    lexer_state = lexer_state::normal;
    //println("cute.yylex.entry: return arg_end");
    return CuteParser::make_V_ARG_END(loc);
  }

 // flex rules section
 /* only c-style comments starting at second column allowed inside rules section */
 /* first rule starts at beginning of line */

 /* assumes typical identifier syntax */
[a-z_A-Z][a-z_A-Z0-9]* {
  loc.columns(yyleng);
  return CuteParser::make_IDENTIFIER(yytext, loc);
}

 /* doubledash operation name */
"--" {
  BEGIN(OPERATION);
  loc.columns(yyleng);
  return CuteParser::make_DASH_DASH(loc);
}

 /* dash allowed in operation and option names */
<OPERATION>{
  [a-z_A-Z][-a-z_A-Z0-9]* {
    BEGIN(0);
    loc.columns(yyleng);
    return CuteParser::make_O_NAME(yytext, loc);
  }
}

 /* assumes multiline string literals are not allowed */
(?x: ["] ( [^"\n] | \\["] | \\\\ )* ["] ) {
  loc.columns(yyleng);
  return CuteParser::make_STRING(yytext, loc);
}

 /* unquoted string */
 /* cannot start with dash, cannot have space, quote, comma, semicolon */
[^-[:space:]",;][^[:space:]",;]+ {
  loc.columns(yyleng);
  return CuteParser::make_STRING(yytext, loc);
}

 /* comma separator */
"," {
  loc.columns(yyleng);
  return CuteParser::make_COMMA(loc);
}

 /* semicolon terminator */
 /* also see logic for  semicolon insertion in place of newline terminator */
";" {
  loc.columns(yyleng);
  return CuteParser::make_SEMICOLON(loc);
}

"|" {
  loc.columns(yyleng);
  return CuteParser::make_PIPE(loc);
}

 /* match newlines separately to correctly update line numbers */
\n {
  loc.lines(yyleng);
  newline_seen = true;
}

 /* whitespace except newline, same as [ \t\v\f\r] but easier to understand */
([[:space:]]{-}[\n])+ {
  loc.columns(yyleng);
}


 /* all input must be consumed in every state to prevent flex scanner jammed error */
<*>. {
  loc.columns(yyleng);
  throw CuteParser::syntax_error(loc, "bad input \""s + yytext + "\""s);
}

<<EOF>> {
  if(lexer_state == lexer_state::argList) {
    if(numArgLeft == 0) {
      lexer_state = lexer_state::normal;
      println("cute.yylex.eof: return arg_end");
      return CuteParser::make_V_ARG_END(loc);
    }
  }
  return CuteParser::make_YYEOF(loc);
}
